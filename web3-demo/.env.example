# The verified BOT 677 CommitmentAnchor address and runtime hash are pinned in
# lib/anchor.ts. Production reads must not silently target another contract.

# Public visitor writes require an explicit later release decision.
ENABLE_PUBLIC_DEMO_WRITES=false
# Keep task signatures disabled until the user reviews and authorizes that step.
NEXT_PUBLIC_ENABLE_TASK_SIGNATURES=false
# Mainnet writes require separate deployment and anchorTask approvals.
NEXT_PUBLIC_ENABLE_MAINNET_WRITES=false

# Contract deployment needs its own explicit approval; default remains disabled.
NEXT_PUBLIC_ENABLE_MAINNET_DEPLOY=false
