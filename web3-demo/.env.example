# The verified BOT 677 CommitmentAnchor address and runtime hash are pinned in
# lib/anchor.ts. Production reads must not silently target another contract.

# Local development stays closed unless manually enabled for an authorized test.
# For Vercel Production, leave unset or set true; do not copy this local false.
ENABLE_PUBLIC_DEMO_WRITES=false
# Independent emergency stop: set to true to disable visitor mainnet writes.
DISABLE_PUBLIC_DEMO_WRITES=false
# Legacy fixed-Demo Python verification endpoint is development-only; /try uses
# browser-side verification and does not depend on this flag.
NEXT_PUBLIC_ENABLE_TASK_SIGNATURES=false
# Legacy fixed-Demo gate; this does not control the visitor-owned /try flow.
NEXT_PUBLIC_ENABLE_MAINNET_WRITES=false

# Contract deployment needs its own explicit approval; default remains disabled.
NEXT_PUBLIC_ENABLE_MAINNET_DEPLOY=false
