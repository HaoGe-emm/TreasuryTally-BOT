{
  "name": "treasury-tally-bot-web3-demo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit --incremental false",
    "test:anchor-local": "npm --prefix ../local-evm test",
    "test:unit": "tsc -p tsconfig.test.json && node scripts/check_units.cjs",
    "test:visitor-cross": "tsc -p tsconfig.test.json && node scripts/check_visitor_cross.cjs",
    "test:write-status": "node --experimental-strip-types scripts/check_write_status.mjs && node --experimental-strip-types scripts/check_visitor_write_gate.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
