{
  "$defs": {
    "ClarificationIssue": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "options": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Options",
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/ClarificationTarget"
        }
      },
      "required": [
        "target",
        "description"
      ],
      "title": "ClarificationIssue",
      "type": "object"
    },
    "ClarificationTarget": {
      "enum": [
        "chain_id",
        "token_address",
        "treasury_addresses",
        "recipient_addresses",
        "start_block",
        "end_block",
        "exclusion_rules",
        "claimed_total",
        "claimed_count",
        "transfer_set"
      ],
      "title": "ClarificationTarget",
      "type": "string"
    },
    "ExclusionRule": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_type": {
          "$ref": "#/$defs/ExclusionRuleType"
        }
      },
      "required": [
        "rule_id",
        "rule_type",
        "reason"
      ],
      "title": "ExclusionRule",
      "type": "object"
    },
    "ExclusionRuleType": {
      "enum": [
        "EXCLUDE_TREASURY_INTERNAL"
      ],
      "title": "ExclusionRuleType",
      "type": "string"
    },
    "TaskField": {
      "enum": [
        "chain_id",
        "token_address",
        "treasury_addresses",
        "recipient_addresses",
        "start_block",
        "end_block",
        "exclusion_rules"
      ],
      "title": "TaskField",
      "type": "string"
    }
  },
  "$id": "urn:xinjv:schema:1.0:task-spec-candidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Unconfirmed task fields; identity, confirmation time, and hash are never model-owned.",
  "properties": {
    "ambiguities": {
      "items": {
        "$ref": "#/$defs/ClarificationIssue"
      },
      "title": "Ambiguities",
      "type": "array"
    },
    "candidate_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "chain_id": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Chain Id"
    },
    "clarification_questions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Clarification Questions",
      "type": "array"
    },
    "end_block": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "End Block"
    },
    "exclusion_rules": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ExclusionRule"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Exclusion Rules"
    },
    "max_records": {
      "const": 200,
      "title": "Max Records",
      "type": "integer"
    },
    "missing_fields": {
      "items": {
        "$ref": "#/$defs/TaskField"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "recipient_addresses": {
      "anyOf": [
        {
          "items": {
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Recipient Addresses"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "start_block": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Start Block"
    },
    "token_address": {
      "anyOf": [
        {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Token Address"
    },
    "treasury_addresses": {
      "anyOf": [
        {
          "items": {
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Treasury Addresses"
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "chain_id",
    "token_address",
    "treasury_addresses",
    "recipient_addresses",
    "start_block",
    "end_block",
    "exclusion_rules",
    "max_records",
    "ambiguities",
    "missing_fields",
    "clarification_questions"
  ],
  "title": "TaskSpecCandidate",
  "type": "object",
  "x-contract-invariants": [
    "missing_fields exactly identify null required task fields",
    "unresolved candidates require clarification questions",
    "resolved candidates contain no clarification questions"
  ]
}
