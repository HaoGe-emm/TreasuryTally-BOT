{
  "$defs": {
    "AggregationRuleType": {
      "enum": [
        "SUM_BASE_UNITS",
        "COUNT_TRANSFERS"
      ],
      "title": "AggregationRuleType",
      "type": "string"
    },
    "ApprovedAggregationRule": {
      "additionalProperties": false,
      "properties": {
        "aggregation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Aggregation Id",
          "type": "string"
        },
        "aggregation_type": {
          "$ref": "#/$defs/AggregationRuleType"
        },
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "aggregation_id",
        "aggregation_type",
        "arguments"
      ],
      "title": "ApprovedAggregationRule",
      "type": "object"
    },
    "ApprovedCheck": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "check_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "check_type": {
          "$ref": "#/$defs/CheckType"
        }
      },
      "required": [
        "check_id",
        "check_type",
        "arguments"
      ],
      "title": "ApprovedCheck",
      "type": "object"
    },
    "ApprovedFilter": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "filter_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Filter Id",
          "type": "string"
        },
        "filter_type": {
          "$ref": "#/$defs/FilterType"
        }
      },
      "required": [
        "filter_id",
        "filter_type",
        "arguments"
      ],
      "title": "ApprovedFilter",
      "type": "object"
    },
    "ApprovedQuery": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "query_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Query Id",
          "type": "string"
        },
        "query_type": {
          "$ref": "#/$defs/QueryType"
        }
      },
      "required": [
        "query_id",
        "query_type",
        "arguments"
      ],
      "title": "ApprovedQuery",
      "type": "object"
    },
    "CheckType": {
      "enum": [
        "COMPARE_EVENT_SET",
        "COMPARE_TOTAL",
        "DETECT_DUPLICATES",
        "VALIDATE_SCOPE",
        "VALIDATE_TOKEN_DECIMALS"
      ],
      "title": "CheckType",
      "type": "string"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/ClaimType"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "claim_id",
        "claim_type",
        "value"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimType": {
      "enum": [
        "CLAIMED_TOTAL",
        "CLAIMED_COUNT",
        "TRANSFER_SET"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "EvidenceDescriptor": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "event_keys": {
          "items": {
            "type": "string"
          },
          "title": "Event Keys",
          "type": "array"
        },
        "evidence_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource"
        },
        "uri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uri"
        }
      },
      "required": [
        "evidence_id",
        "source",
        "content_hash",
        "uri",
        "event_keys"
      ],
      "title": "EvidenceDescriptor",
      "type": "object"
    },
    "EvidenceSource": {
      "enum": [
        "rpc",
        "blockscout",
        "service"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "ExclusionRule": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_type": {
          "$ref": "#/$defs/ExclusionRuleType"
        }
      },
      "required": [
        "rule_id",
        "rule_type",
        "reason"
      ],
      "title": "ExclusionRule",
      "type": "object"
    },
    "ExclusionRuleType": {
      "enum": [
        "EXCLUDE_TREASURY_INTERNAL"
      ],
      "title": "ExclusionRuleType",
      "type": "string"
    },
    "FilterType": {
      "enum": [
        "TOKEN_ADDRESS",
        "BLOCK_RANGE",
        "TREASURY_DIRECTION",
        "EXCLUDE_INTERNAL_TRANSFER",
        "RECIPIENT_SET"
      ],
      "title": "FilterType",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "expected": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "finding_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "finding_type": {
          "$ref": "#/$defs/FindingType"
        },
        "severity": {
          "$ref": "#/$defs/FindingSeverity"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus"
        },
        "violated_rule": {
          "minLength": 1,
          "title": "Violated Rule",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "finding_type",
        "severity",
        "expected",
        "actual",
        "violated_rule",
        "evidence_refs",
        "explanation",
        "status"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingSeverity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "FindingSeverity",
      "type": "string"
    },
    "FindingStatus": {
      "enum": [
        "confirmed",
        "hypothesis"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "FindingType": {
      "enum": [
        "MISSING_TRANSFER",
        "EXTRA_TRANSFER",
        "DUPLICATE_TRANSFER",
        "EXCLUDED_INTERNAL_TRANSFER",
        "OUT_OF_RANGE",
        "WRONG_TOKEN",
        "WRONG_DIRECTION",
        "AMOUNT_MISMATCH",
        "DECIMAL_ERROR",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "FindingType",
      "type": "string"
    },
    "JsonValue": {},
    "Publication": {
      "additionalProperties": false,
      "properties": {
        "authorized": {
          "title": "Authorized",
          "type": "boolean"
        },
        "block_number": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Number"
        },
        "chain_id": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chain Id"
        },
        "chain_status": {
          "$ref": "#/$defs/PublicationChainStatus"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^0x[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Content Hash"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "error_message": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "feedback_index": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback Index"
        },
        "reviewer_address": {
          "anyOf": [
            {
              "pattern": "^0x[0-9a-fA-F]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Address"
        },
        "transaction_hash": {
          "anyOf": [
            {
              "pattern": "^0x[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Transaction Hash"
        },
        "transaction_nonce": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transaction Nonce"
        },
        "uri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uri"
        }
      },
      "required": [
        "authorized",
        "uri",
        "content_hash",
        "transaction_hash",
        "chain_status"
      ],
      "title": "Publication",
      "type": "object"
    },
    "PublicationChainStatus": {
      "enum": [
        "NOT_SUBMITTED",
        "SUBMITTED",
        "CONFIRMED",
        "FAILED"
      ],
      "title": "PublicationChainStatus",
      "type": "string"
    },
    "QueryType": {
      "enum": [
        "FETCH_ERC20_TRANSFERS"
      ],
      "title": "QueryType",
      "type": "string"
    },
    "ServiceIdentity": {
      "additionalProperties": false,
      "properties": {
        "identity_reference": {
          "minLength": 1,
          "title": "Identity Reference",
          "type": "string"
        },
        "identity_scheme": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Identity Scheme",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "service_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Service Id",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "name",
        "identity_scheme",
        "identity_reference"
      ],
      "title": "ServiceIdentity",
      "type": "object"
    },
    "SourceDescriptor": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "retrieved_at": {
          "format": "date-time",
          "pattern": ".*(?:Z|[+-]00:00)$",
          "title": "Retrieved At",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source",
        "source_id",
        "retrieved_at",
        "complete",
        "details"
      ],
      "title": "SourceDescriptor",
      "type": "object"
    },
    "TaskSpec": {
      "additionalProperties": false,
      "properties": {
        "chain_id": {
          "exclusiveMinimum": 0,
          "title": "Chain Id",
          "type": "integer"
        },
        "confirmed_at": {
          "format": "date-time",
          "pattern": ".*(?:Z|[+-]00:00)$",
          "title": "Confirmed At",
          "type": "string"
        },
        "end_block": {
          "minimum": 0,
          "title": "End Block",
          "type": "integer"
        },
        "exclusion_rules": {
          "items": {
            "$ref": "#/$defs/ExclusionRule"
          },
          "title": "Exclusion Rules",
          "type": "array"
        },
        "max_records": {
          "const": 200,
          "title": "Max Records",
          "type": "integer"
        },
        "recipient_addresses": {
          "items": {
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Recipient Addresses",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "spec_hash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "title": "Spec Hash",
          "type": "string"
        },
        "start_block": {
          "minimum": 0,
          "title": "Start Block",
          "type": "integer"
        },
        "task_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "token_address": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Token Address",
          "type": "string"
        },
        "treasury_addresses": {
          "items": {
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Treasury Addresses",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "chain_id",
        "token_address",
        "treasury_addresses",
        "recipient_addresses",
        "start_block",
        "end_block",
        "exclusion_rules",
        "max_records",
        "confirmed_at",
        "spec_hash"
      ],
      "title": "TaskSpec",
      "type": "object"
    },
    "VerificationOutcome": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ],
      "title": "VerificationOutcome",
      "type": "string"
    },
    "VerificationPlan": {
      "additionalProperties": false,
      "properties": {
        "aggregation_rules": {
          "items": {
            "$ref": "#/$defs/ApprovedAggregationRule"
          },
          "minItems": 1,
          "title": "Aggregation Rules",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/ApprovedCheck"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "minItems": 1,
          "title": "Claims",
          "type": "array"
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/ApprovedFilter"
          },
          "minItems": 1,
          "title": "Filters",
          "type": "array"
        },
        "plan_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "plan_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Plan Version",
          "type": "string"
        },
        "queries": {
          "items": {
            "$ref": "#/$defs/ApprovedQuery"
          },
          "minItems": 1,
          "title": "Queries",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "plan_id",
        "task_id",
        "claims",
        "queries",
        "filters",
        "aggregation_rules",
        "checks",
        "plan_version"
      ],
      "title": "VerificationPlan",
      "type": "object"
    },
    "VerificationResult": {
      "additionalProperties": false,
      "properties": {
        "calculated_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calculated Count"
        },
        "calculated_total_base_units": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calculated Total Base Units"
        },
        "evidence_sufficient": {
          "title": "Evidence Sufficient",
          "type": "boolean"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "finished_at": {
          "format": "date-time",
          "pattern": ".*(?:Z|[+-]00:00)$",
          "title": "Finished At",
          "type": "string"
        },
        "inconclusive_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Inconclusive Reason"
        },
        "outcome": {
          "$ref": "#/$defs/VerificationOutcome"
        },
        "reference_complete": {
          "title": "Reference Complete",
          "type": "boolean"
        },
        "reference_sources": {
          "items": {
            "$ref": "#/$defs/SourceDescriptor"
          },
          "title": "Reference Sources",
          "type": "array"
        },
        "run_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "pattern": ".*(?:Z|[+-]00:00)$",
          "title": "Started At",
          "type": "string"
        },
        "submission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Submission Id",
          "type": "string"
        },
        "task_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "verifier_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Verifier Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "task_id",
        "submission_id",
        "verifier_version",
        "reference_sources",
        "reference_complete",
        "evidence_sufficient",
        "calculated_total_base_units",
        "calculated_count",
        "findings",
        "outcome",
        "inconclusive_reason",
        "started_at",
        "finished_at"
      ],
      "title": "VerificationResult",
      "type": "object"
    }
  },
  "$id": "urn:xinjv:schema:1.0:receipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "pattern": ".*(?:Z|[+-]00:00)$",
      "title": "Created At",
      "type": "string"
    },
    "evidence_manifest": {
      "items": {
        "$ref": "#/$defs/EvidenceDescriptor"
      },
      "title": "Evidence Manifest",
      "type": "array"
    },
    "publication": {
      "$ref": "#/$defs/Publication"
    },
    "receipt_hash": {
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "title": "Receipt Hash",
      "type": "string"
    },
    "receipt_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Receipt Id",
      "type": "string"
    },
    "receipt_version": {
      "const": "1.0",
      "title": "Receipt Version",
      "type": "string"
    },
    "service_identity": {
      "$ref": "#/$defs/ServiceIdentity"
    },
    "submission_hash": {
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "title": "Submission Hash",
      "type": "string"
    },
    "task_spec": {
      "$ref": "#/$defs/TaskSpec"
    },
    "verification_plan": {
      "$ref": "#/$defs/VerificationPlan"
    },
    "verification_result": {
      "$ref": "#/$defs/VerificationResult"
    }
  },
  "required": [
    "receipt_version",
    "receipt_id",
    "task_spec",
    "service_identity",
    "submission_hash",
    "verification_plan",
    "verification_result",
    "evidence_manifest",
    "created_at",
    "receipt_hash",
    "publication"
  ],
  "title": "Receipt",
  "type": "object",
  "x-contract-invariants": [
    "nested task references equal task_spec.task_id"
  ]
}
