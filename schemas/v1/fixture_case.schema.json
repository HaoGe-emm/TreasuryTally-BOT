{
  "$defs": {
    "EvidenceSource": {
      "enum": [
        "rpc",
        "blockscout",
        "service"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "ExclusionRule": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_type": {
          "$ref": "#/$defs/ExclusionRuleType"
        }
      },
      "required": [
        "rule_id",
        "rule_type",
        "reason"
      ],
      "title": "ExclusionRule",
      "type": "object"
    },
    "ExclusionRuleType": {
      "enum": [
        "EXCLUDE_TREASURY_INTERNAL"
      ],
      "title": "ExclusionRuleType",
      "type": "string"
    },
    "ExpectedFinding": {
      "additionalProperties": false,
      "properties": {
        "event_keys": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              {
                "pattern": "^0x[0-9a-fA-F]{64}$",
                "type": "string"
              },
              {
                "minimum": 0,
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Event Keys",
          "type": "array"
        },
        "finding_type": {
          "$ref": "#/$defs/FindingType"
        },
        "severity": {
          "$ref": "#/$defs/FindingSeverity"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus"
        },
        "violated_rule": {
          "minLength": 1,
          "title": "Violated Rule",
          "type": "string"
        }
      },
      "required": [
        "finding_type",
        "severity",
        "status",
        "violated_rule",
        "event_keys"
      ],
      "title": "ExpectedFinding",
      "type": "object"
    },
    "FindingSeverity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "FindingSeverity",
      "type": "string"
    },
    "FindingStatus": {
      "enum": [
        "confirmed",
        "hypothesis"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "FindingType": {
      "enum": [
        "MISSING_TRANSFER",
        "EXTRA_TRANSFER",
        "DUPLICATE_TRANSFER",
        "EXCLUDED_INTERNAL_TRANSFER",
        "OUT_OF_RANGE",
        "WRONG_TOKEN",
        "WRONG_DIRECTION",
        "AMOUNT_MISMATCH",
        "DECIMAL_ERROR",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "FindingType",
      "type": "string"
    },
    "FixtureExpectedResult": {
      "additionalProperties": false,
      "properties": {
        "calculated_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calculated Count"
        },
        "calculated_total_base_units": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calculated Total Base Units"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ExpectedFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/VerificationOutcome"
        }
      },
      "required": [
        "outcome",
        "calculated_total_base_units",
        "calculated_count",
        "findings"
      ],
      "title": "FixtureExpectedResult",
      "type": "object"
    },
    "FixtureReference": {
      "additionalProperties": false,
      "properties": {
        "evidence_sufficient": {
          "title": "Evidence Sufficient",
          "type": "boolean"
        },
        "insufficiency_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Insufficiency Reason"
        },
        "reference_complete": {
          "title": "Reference Complete",
          "type": "boolean"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceDescriptor"
          },
          "title": "Sources",
          "type": "array"
        },
        "transfers": {
          "items": {
            "$ref": "#/$defs/TransferRecord"
          },
          "maxItems": 200,
          "title": "Transfers",
          "type": "array"
        }
      },
      "required": [
        "sources",
        "reference_complete",
        "evidence_sufficient",
        "transfers",
        "insufficiency_reason"
      ],
      "title": "FixtureReference",
      "type": "object"
    },
    "HumanReview": {
      "additionalProperties": false,
      "properties": {
        "calculation": {
          "minLength": 1,
          "title": "Calculation",
          "type": "string"
        },
        "reviewer": {
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "verified_at": {
          "format": "date-time",
          "pattern": ".*(?:Z|[+-]00:00)$",
          "title": "Verified At",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "calculation",
        "reviewer",
        "verified_at"
      ],
      "title": "HumanReview",
      "type": "object"
    },
    "JsonValue": {},
    "ServiceSubmission": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "maximum": 2,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "claimed_count": {
          "minimum": 0,
          "title": "Claimed Count",
          "type": "integer"
        },
        "claimed_total_base_units": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Claimed Total Base Units",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "pattern": ".*(?:Z|[+-]00:00)$",
          "title": "Created At",
          "type": "string"
        },
        "report_hash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "title": "Report Hash",
          "type": "string"
        },
        "report_text": {
          "title": "Report Text",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "service_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Service Id",
          "type": "string"
        },
        "service_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Service Version",
          "type": "string"
        },
        "signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Signature"
        },
        "submission_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Submission Id",
          "type": "string"
        },
        "task_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "transfers": {
          "items": {
            "$ref": "#/$defs/TransferRecord"
          },
          "maxItems": 200,
          "title": "Transfers",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "submission_id",
        "task_id",
        "service_id",
        "service_version",
        "attempt",
        "claimed_total_base_units",
        "claimed_count",
        "transfers",
        "report_text",
        "created_at",
        "report_hash",
        "signature"
      ],
      "title": "ServiceSubmission",
      "type": "object"
    },
    "SourceDescriptor": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "retrieved_at": {
          "format": "date-time",
          "pattern": ".*(?:Z|[+-]00:00)$",
          "title": "Retrieved At",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source",
        "source_id",
        "retrieved_at",
        "complete",
        "details"
      ],
      "title": "SourceDescriptor",
      "type": "object"
    },
    "TaskSpec": {
      "additionalProperties": false,
      "properties": {
        "chain_id": {
          "exclusiveMinimum": 0,
          "title": "Chain Id",
          "type": "integer"
        },
        "confirmed_at": {
          "format": "date-time",
          "pattern": ".*(?:Z|[+-]00:00)$",
          "title": "Confirmed At",
          "type": "string"
        },
        "end_block": {
          "minimum": 0,
          "title": "End Block",
          "type": "integer"
        },
        "exclusion_rules": {
          "items": {
            "$ref": "#/$defs/ExclusionRule"
          },
          "title": "Exclusion Rules",
          "type": "array"
        },
        "max_records": {
          "const": 200,
          "title": "Max Records",
          "type": "integer"
        },
        "recipient_addresses": {
          "items": {
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Recipient Addresses",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "spec_hash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "title": "Spec Hash",
          "type": "string"
        },
        "start_block": {
          "minimum": 0,
          "title": "Start Block",
          "type": "integer"
        },
        "task_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "token_address": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Token Address",
          "type": "string"
        },
        "treasury_addresses": {
          "items": {
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Treasury Addresses",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "chain_id",
        "token_address",
        "treasury_addresses",
        "recipient_addresses",
        "start_block",
        "end_block",
        "exclusion_rules",
        "max_records",
        "confirmed_at",
        "spec_hash"
      ],
      "title": "TaskSpec",
      "type": "object"
    },
    "TransferRecord": {
      "additionalProperties": false,
      "properties": {
        "amount_base_units": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Amount Base Units",
          "type": "string"
        },
        "block_hash": {
          "anyOf": [
            {
              "pattern": "^0x[0-9a-fA-F]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Block Hash"
        },
        "block_number": {
          "minimum": 0,
          "title": "Block Number",
          "type": "integer"
        },
        "chain_id": {
          "exclusiveMinimum": 0,
          "title": "Chain Id",
          "type": "integer"
        },
        "from_address": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "From Address",
          "type": "string"
        },
        "log_index": {
          "minimum": 0,
          "title": "Log Index",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource"
        },
        "to_address": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "To Address",
          "type": "string"
        },
        "token_address": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Token Address",
          "type": "string"
        },
        "token_decimals": {
          "maximum": 255,
          "minimum": 0,
          "title": "Token Decimals",
          "type": "integer"
        },
        "transaction_hash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "title": "Transaction Hash",
          "type": "string"
        }
      },
      "required": [
        "chain_id",
        "token_address",
        "transaction_hash",
        "log_index",
        "block_number",
        "block_hash",
        "from_address",
        "to_address",
        "amount_base_units",
        "token_decimals",
        "source"
      ],
      "title": "TransferRecord",
      "type": "object"
    },
    "VerificationOutcome": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ],
      "title": "VerificationOutcome",
      "type": "string"
    }
  },
  "$id": "urn:xinjv:schema:1.0:fixture-case",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expected": {
      "$ref": "#/$defs/FixtureExpectedResult"
    },
    "fixture_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Fixture Id",
      "type": "string"
    },
    "fixture_version": {
      "const": "1.0",
      "title": "Fixture Version",
      "type": "string"
    },
    "human_review": {
      "$ref": "#/$defs/HumanReview"
    },
    "reference": {
      "$ref": "#/$defs/FixtureReference"
    },
    "submission": {
      "$ref": "#/$defs/ServiceSubmission"
    },
    "tags": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Tags",
      "type": "array"
    },
    "task_spec": {
      "$ref": "#/$defs/TaskSpec"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "fixture_version",
    "fixture_id",
    "title",
    "tags",
    "task_spec",
    "submission",
    "reference",
    "expected",
    "human_review"
  ],
  "title": "FixtureCase",
  "type": "object",
  "x-contract-invariants": [
    "submission.task_id equals task_spec.task_id",
    "reference and expected outcome preserve evidence sufficiency",
    "confirmed error findings determine FAIL for conclusive cases"
  ]
}
