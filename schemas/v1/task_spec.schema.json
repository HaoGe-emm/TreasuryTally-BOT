{
  "$defs": {
    "ExclusionRule": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_type": {
          "$ref": "#/$defs/ExclusionRuleType"
        }
      },
      "required": [
        "rule_id",
        "rule_type",
        "reason"
      ],
      "title": "ExclusionRule",
      "type": "object"
    },
    "ExclusionRuleType": {
      "enum": [
        "EXCLUDE_TREASURY_INTERNAL"
      ],
      "title": "ExclusionRuleType",
      "type": "string"
    }
  },
  "$id": "urn:xinjv:schema:1.0:task-spec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chain_id": {
      "exclusiveMinimum": 0,
      "title": "Chain Id",
      "type": "integer"
    },
    "confirmed_at": {
      "format": "date-time",
      "pattern": ".*(?:Z|[+-]00:00)$",
      "title": "Confirmed At",
      "type": "string"
    },
    "end_block": {
      "minimum": 0,
      "title": "End Block",
      "type": "integer"
    },
    "exclusion_rules": {
      "items": {
        "$ref": "#/$defs/ExclusionRule"
      },
      "title": "Exclusion Rules",
      "type": "array"
    },
    "max_records": {
      "const": 200,
      "title": "Max Records",
      "type": "integer"
    },
    "recipient_addresses": {
      "items": {
        "pattern": "^0x[0-9a-fA-F]{40}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Recipient Addresses",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "spec_hash": {
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "title": "Spec Hash",
      "type": "string"
    },
    "start_block": {
      "minimum": 0,
      "title": "Start Block",
      "type": "integer"
    },
    "task_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "token_address": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Token Address",
      "type": "string"
    },
    "treasury_addresses": {
      "items": {
        "pattern": "^0x[0-9a-fA-F]{40}$",
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Treasury Addresses",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "chain_id",
    "token_address",
    "treasury_addresses",
    "recipient_addresses",
    "start_block",
    "end_block",
    "exclusion_rules",
    "max_records",
    "confirmed_at",
    "spec_hash"
  ],
  "title": "TaskSpec",
  "type": "object",
  "x-contract-invariants": [
    "start_block <= end_block",
    "treasury_addresses and recipient_addresses are unique ignoring case",
    "exclusion rule IDs are unique"
  ]
}
