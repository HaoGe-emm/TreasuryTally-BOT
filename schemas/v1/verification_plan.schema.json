  "$id": "urn:xinjv:schema:1.0:verification-plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregation_rules": {
      "items": {
        "$ref": "#/$defs/ApprovedAggregationRule"
      },
      "minItems": 1,
      "title": "Aggregation Rules",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/ApprovedCheck"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "filters": {
      "items": {
        "$ref": "#/$defs/ApprovedFilter"
      },
      "minItems": 1,
      "title": "Filters",
      "type": "array"
    },
    "plan_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "plan_version": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Plan Version",
      "type": "string"
    },
    "queries": {
      "items": {
        "$ref": "#/$defs/ApprovedQuery"
      },
      "minItems": 1,
      "title": "Queries",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "task_id",
    "claims",
    "queries",
    "filters",
    "aggregation_rules",
    "checks",
    "plan_version"
  ],
  "title": "VerificationPlan",
  "type": "object"
}
